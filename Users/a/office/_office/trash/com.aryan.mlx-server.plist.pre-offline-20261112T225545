<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.aryan.mlx-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/a/.venvs/mlx/bin/python</string>
		<string>-m</string>
		<string>mlx_lm.server</string>
		<string>--model</string>
		<string>mlx-community/gemma-3-1b-it-qat-4bit</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>11434</string>
		<string>--prompt-cache-size</string>
		<string>4</string>
		<string>--prompt-cache-bytes</string>
		<string>268435456</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/com.aryan.mlx-server.err</string>
	<key>StandardOutPath</key>
	<string>/tmp/com.aryan.mlx-server.out</string>
</dict>
</plist>
